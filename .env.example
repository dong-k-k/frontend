# Backend API host (server-side only, used by the Next.js rewrite proxy in
# next.config.ts). The backend doesn't send CORS headers, so the browser
# must talk to /backend-api (same-origin) instead of this host directly.
BACKEND_API_URL=

# Base path the frontend calls from the browser. Leave as /backend-api to go
# through the proxy above.
NEXT_PUBLIC_API_BASE_URL=/backend-api
